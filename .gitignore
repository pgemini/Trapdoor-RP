# =============================================================
# Trapdoor — root .gitignore
# =============================================================

# --- Secrets (never commit) ----------------------------------
.env
.env.local
*.env.local
backend/.env
**/secrets.*

# --- Python --------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.venv/

# --- Node / Next.js ------------------------------------------
node_modules/
web/node_modules/
.next/
web/.next/
out/
web/out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Demo samples are committed (pre-generated) so deployments don't need
# pyttsx3 / opencv at build time. If you regenerate them locally, replace
# the committed files via git add.

# --- OS / editor ---------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ----------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build artefacts ----------------------------------------
dist/
build/
.coverage
htmlcov/

# --- Misc ----------------------------------------------------
*.local
.bun
.pnpm-store/
.claude/
