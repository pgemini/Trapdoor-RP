# =============================================================
# Trapdoor web (Next.js) — environment template
# =============================================================
# Copy this file to `.env.local` and fill in the values.  .env.local is
# gitignored, so your secrets stay out of git.
#
#   PowerShell:  Copy-Item .env.local.example .env.local
#   bash:        cp .env.local.example .env.local

# ---- Build-time configuration ------------------------------
# Required when building for Azure Static Web Apps deploy.
TRAPDOOR_STATIC_EXPORT=1

# Render backend URL the frontend will call at runtime.
# Without this, scans hit /api/* same-origin and there's nothing to answer.
NEXT_PUBLIC_API_BASE=https://<your-render-backend>.onrender.com


# ---- Azure SWA deploy token --------------------------------
# Used by deploy.ps1 / deploy.sh.  Get this value from:
#   Azure portal → Static Web Apps → <your SWA> → Manage deployment token
#
# IMPORTANT:
#   * never paste this into chat, commit messages, or screenshots
#   * rotate immediately if it's ever exposed
#   * .env.local is gitignored so this file is safe locally
AZURE_SWA_DEPLOY_TOKEN=
